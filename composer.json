{
    "name": "voyager/console",
    "description": "The Voyager Console package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "ext-mbstring": "*",
        "voyager/collections": "^0.8.0",
        "voyager/contracts": "^0.8.0",
        "voyager/macroable": "^0.8.0",
        "voyager/nuts-and-bolts": "^0.8.0",
        "laravel/prompts": "^0.3.0",
        "nunomaduro/termwind": "^2.0",
        "symfony/console": "^7.2.0",
        "symfony/polyfill-php83": "^1.33",
        "symfony/process": "^7.2.0"
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Console\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        },
        "venusian": {
            "upstream": "laravel/framework",
            "upstream-ref": "v12.67.0",
            "upstream-path": "src/Illuminate/Console",
            "ported-at": "2026-08-19"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
